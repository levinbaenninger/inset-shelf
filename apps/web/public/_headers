# Cloudflare static assets headers. Next copies public/ into out/, which wrangler.jsonc serves.
#
# CSP: the static export inlines Next's flight data and the theme script as <script> blocks,
# and components use style attributes, so script-src and style-src need 'unsafe-inline'.
# Everything else is same-origin: fonts are self-hosted (geist), search reads /api/search
# from this origin, and no third-party host is loaded.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
