<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs to generate code at run time. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Needed while the app is self-signed (the Electron frameworks have another team ID). Drop with a Developer ID. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- The page address of the capture source is read through osascript. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
  </dict>
</plist>
