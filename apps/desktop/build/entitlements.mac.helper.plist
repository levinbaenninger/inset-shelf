<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- The renderer and utility helpers run V8, which generates code at run time. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Needed while the app is self-signed: without a team ID, library validation rejects the bundled frameworks. Drop with a Developer ID. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
